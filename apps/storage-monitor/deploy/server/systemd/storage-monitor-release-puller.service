[Unit]
Description=Storage Monitor dashboard release puller
Documentation=https://github.com/IRCVLab/GPU_monitor
Wants=network-online.target
After=network-online.target
ConditionPathExists=/usr/local/libexec/storage-monitor-release-puller.py
ConditionPathExists=/usr/local/libexec/storage-dashboard-activate.py
ConditionPathExists=/usr/local/libexec/storage-release-authorizer.py

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/storage-viz-dashboard/releases /var/lib/storage-viz-dashboard /etc/storage-viz /opt/storage-viz-dashboard
WorkingDirectory=/var/lib/storage-viz-dashboard/puller
ExecStart=/usr/bin/python3.12 /usr/local/libexec/storage-monitor-release-puller.py --repository IRCVLab/GPU_monitor --repo-url https://github.com/IRCVLab/GPU_monitor.git --state-dir /var/lib/storage-viz-dashboard/puller --work-dir /var/lib/storage-viz-dashboard/builder --authorizer /usr/local/libexec/storage-release-authorizer.py --activate /usr/local/libexec/storage-dashboard-activate.py --builder-user storage-viz-builder
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @chown @file-system @io-event @network-io @process @resources
