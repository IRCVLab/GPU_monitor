[Unit]
Description=Storage Viz public proxy
After=network-online.target storage-viz-dashboard.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/storage-viz/proxy.env
User=storage-viz
Group=storage-viz
WorkingDirectory=/opt/storage-viz-dashboard
ExecStart=/usr/bin/python3 /opt/storage-viz-dashboard/deploy/server/storage-viz-proxy-launcher.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/storage-viz-dashboard/activation-state.json
ReadOnlyPaths=/var/lib/storage-viz-dashboard/legacy-proxy
ReadOnlyPaths=/srv/storage-viz-dashboard/releases /opt/storage-viz-dashboard /etc/storage-viz/proxy.env
InaccessiblePaths=-/var/lib/storage-viz-dashboard/data
InaccessiblePaths=-/var/lib/storage-viz-dashboard/state -/var/lib/storage-viz-dashboard/puller -/var/lib/storage-viz-dashboard/builder -/var/lib/storage-viz-dashboard/incoming
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
