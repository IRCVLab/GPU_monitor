# 필수 설정
SECRET_KEY=change-me-to-a-random-32-byte-string
ADMIN_PASSWORD=change-me

# DB 경로 (기본값: data/gpu_monitor.db)
# DATABASE_URL=sqlite+aiosqlite:///data/gpu_monitor.db
# MONITORING_EXPECTED_SERVER_COUNT=9
# MONITORING_DATABASE_BACKUP_DIR=/var/backups/gpu-monitor
# MONITORING_DATABASE_BACKUP_KEEP=5

# GPU 자동 실험 메모 (선택). 두 값을 설정하고 백엔드를 재시작한 뒤 관리 메뉴에서 켭니다.
# 키는 연구실 OpenAI 프로젝트의 백엔드 자격 증명을 사용하세요.
# EXPERIMENT_NOTES_OPENAI_API_KEY=
# EXPERIMENT_NOTES_MODEL=

# PSU 정격 출력 W (선택). 서버 ID 및 PSU 슬롯별로 BMC 인벤토리 또는 라벨에서 확인한 값.
# HARDWARE_PSU_RATED_OUTPUT_WATTS='{"7":{"PSU1":1600,"PSU2":1600}}'

# Slack (선택 — 없으면 알림 비활성화)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# SLACK_LOG_CHANNEL=#gpu-monitor
