[Unit]
Description=GPU Monitor frontend (%i)
After=network.target

[Service]
Type=simple
User=gpu-deploy
WorkingDirectory=/srv/gpu-monitor/%i/current/frontend
EnvironmentFile=/etc/gpu-monitor/%i.env
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node /srv/gpu-monitor/%i/current/frontend/build/index.js
Restart=on-failure

[Install]
WantedBy=multi-user.target
