[Unit]
Description=GPU Monitor frontend (%i)
After=network.target

[Service]
Type=simple
User=gpu-monitor-%i
Group=gpu-monitor-%i
WorkingDirectory=/srv/gpu-monitor/%i/current/frontend
EnvironmentFile=/etc/gpu-monitor/%i.env
ExecStart=/opt/gpu-monitor/node/bin/node /srv/gpu-monitor/%i/current/frontend/server.mjs
Restart=on-failure
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
