#!/usr/bin/env bash
set -euo pipefail

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
PREFIX_IN=${PREFIX:-}
TEST_PATH=${GPU_MONITOR_TEST_PATH:-}
MAX_UPLOAD=${GPU_MONITOR_MAX_UPLOAD_BYTES:-536870912}
ALLOWED_ENV=${GPU_MONITOR_ALLOWED_ENV:-}
if [[ $# -gt 0 ]]; then
  [[ $# -eq 1 ]] || fail "usage: gpu-monitor-deploy-command [dev|live]"
  case "$1" in dev|live) ALLOWED_ENV="$1" ;; *) fail "invalid authorized environment" ;; esac
fi
ORIGINAL=${SSH_ORIGINAL_COMMAND:-}
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
[[ -n "$TEST_PATH" ]] && PATH="$TEST_PATH"
export PATH PREFIX="$PREFIX_IN" GPU_MONITOR_MAX_UPLOAD_BYTES="$MAX_UPLOAD"
INTERNAL_PYTHON="${GPU_MONITOR_INTERNAL_PYTHON:-/usr/bin/python3}"
[[ -x "$INTERNAL_PYTHON" ]] || INTERNAL_PYTHON=$(command -v python3)
[[ -n "$TEST_PATH" ]] && export GPU_MONITOR_TEST_PATH="$TEST_PATH"
unset BASH_ENV ENV CDPATH IFS
IFS=$' \t\n'
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

[[ -n "$ORIGINAL" ]] || fail "missing SSH_ORIGINAL_COMMAND"
cmd=""
env_name=""
sha=""
digest=""
if [[ "$ORIGINAL" =~ ^(upload|activate)\ (dev|live)\ ([0-9a-f]{40})\ ([0-9a-f]{64})$ ]]; then
  cmd=${BASH_REMATCH[1]}
  env_name=${BASH_REMATCH[2]}
  sha=${BASH_REMATCH[3]}
  digest=${BASH_REMATCH[4]}
elif [[ "$ORIGINAL" =~ ^(status|rollback)\ (dev|live)$ ]]; then
  cmd=${BASH_REMATCH[1]}
  env_name=${BASH_REMATCH[2]}
else
  fail "rejected SSH_ORIGINAL_COMMAND"
fi
if [[ -n "$ALLOWED_ENV" && "$env_name" != "$ALLOWED_ENV" ]]; then
  fail "command not authorized for environment"
fi

root="${PREFIX}/srv/gpu-monitor/${env_name}"
mkdir -p "$root/incoming" "$root/releases" "$root/tmp"

case "$cmd:$env_name" in
  upload:dev|upload:live)
    tmp="$root/tmp/upload-${sha}.$$"
    final="$root/incoming/$sha.tar.gz"
    rm -f "$tmp"
    if ! "$INTERNAL_PYTHON" -c 'import hashlib, os, sys
path, expected, max_bytes = sys.argv[1], sys.argv[2], int(sys.argv[3])
h = hashlib.sha256(); total = 0
try:
    with open(path, "wb") as out:
        while True:
            chunk = sys.stdin.buffer.read(1024 * 1024)
            if not chunk:
                break
            total += len(chunk)
            if total > max_bytes:
                raise SystemExit(2)
            h.update(chunk); out.write(chunk)
except BaseException:
    try: os.unlink(path)
    except FileNotFoundError: pass
    raise
if h.hexdigest() != expected:
    os.unlink(path)
    raise SystemExit(3)
' "$tmp" "$digest" "$MAX_UPLOAD"
    then
      rm -f "$tmp"
      fail "upload failed size or digest verification"
    fi
    mv -f "$tmp" "$final"
    printf '{"environment":"%s","sha":"%s","sha256":"%s","status":"uploaded"}\n' "$env_name" "$sha" "$digest"
    ;;
  activate:dev|activate:live)
    exec "$script_dir/activate-release.sh" activate "$env_name" "$sha" "$digest"
    ;;
  status:dev|status:live)
    exec "$script_dir/activate-release.sh" status "$env_name"
    ;;
  rollback:dev|rollback:live)
    exec "$script_dir/activate-release.sh" rollback "$env_name"
    ;;
  *) fail "rejected SSH_ORIGINAL_COMMAND" ;;
esac
