#!/bin/bash -p
set -euo pipefail

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

PRODUCTION_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PRODUCTION_PYTHON=/usr/bin/python3
PRODUCTION_UPLOAD_LIMIT=536870912
test_mode=false

case "$#:${1:-}" in
  1:dev|1:live)
    allowed_env=$1
    prefix=""
    command_path=$PRODUCTION_PATH
    internal_python=$PRODUCTION_PYTHON
    max_upload=$PRODUCTION_UPLOAD_LIMIT
    ;;
  2:--test-mode)
    case "$2" in dev|live) ;; *) fail "invalid test-mode authorized environment" ;; esac
    test_mode=true
    allowed_env=$2
    prefix=${PREFIX:-}
    command_path=${GPU_MONITOR_TEST_PATH:-$PRODUCTION_PATH}
    internal_python=${GPU_MONITOR_INTERNAL_PYTHON:-$PRODUCTION_PYTHON}
    max_upload=${GPU_MONITOR_MAX_UPLOAD_BYTES:-$PRODUCTION_UPLOAD_LIMIT}
    test_max_archive_files=${GPU_MONITOR_MAX_ARCHIVE_FILES:-}
    test_max_expanded_bytes=${GPU_MONITOR_MAX_EXPANDED_BYTES:-}
    test_health_retries=${GPU_MONITOR_HEALTH_RETRIES:-}
    test_health_sleep_seconds=${GPU_MONITOR_HEALTH_SLEEP_SECONDS:-}
    test_max_incoming_count=${GPU_MONITOR_MAX_INCOMING_COUNT:-}
    test_max_incoming_bytes=${GPU_MONITOR_MAX_INCOMING_BYTES:-}
    test_temp_max_age=${GPU_MONITOR_UPLOAD_TEMP_MAX_AGE:-}
    test_failed_max_count=${GPU_MONITOR_FAILED_ARTIFACT_MAX_COUNT:-}
    ;;
  *) fail "usage: gpu-monitor-deploy-command <dev|live> | --test-mode <dev|live>" ;;
esac

original=${SSH_ORIGINAL_COMMAND:-}
unset BASH_ENV ENV CDPATH GLOBIGNORE PREFIX GPU_MONITOR_ALLOWED_ENV \
  GPU_MONITOR_TEST_PATH GPU_MONITOR_MAX_UPLOAD_BYTES GPU_MONITOR_INTERNAL_PYTHON \
  GPU_MONITOR_MAX_ARCHIVE_FILES GPU_MONITOR_MAX_EXPANDED_BYTES \
  GPU_MONITOR_HEALTH_RETRIES GPU_MONITOR_HEALTH_SLEEP_SECONDS \
  GPU_MONITOR_MAX_INCOMING_COUNT GPU_MONITOR_MAX_INCOMING_BYTES \
  GPU_MONITOR_UPLOAD_TEMP_MAX_AGE GPU_MONITOR_FAILED_ARTIFACT_MAX_COUNT \
  PYTHONHOME PYTHONPATH PYTHONSTARTUP NODE_OPTIONS
IFS=$' \t\n'
PATH=$command_path
export PATH

validate_bound() {
  local name=$1 value=$2 maximum=$3
  [[ "$value" =~ ^[0-9]+$ ]] && (( value >= 1 && value <= maximum )) ||
    fail "$name must be between 1 and $maximum"
}
if [[ "$test_mode" == true ]]; then
  [[ "$prefix" == /* && "$prefix" != / && "$prefix" != *$'\n'* ]] || fail "invalid test PREFIX"
  [[ "$internal_python" == /* && -x "$internal_python" ]] || fail "invalid test Python"
  validate_bound "test upload bound" "$max_upload" "$PRODUCTION_UPLOAD_LIMIT"
  IFS=: read -r -a path_parts <<< "$command_path"
  for part in "${path_parts[@]}"; do [[ "$part" == /* && -d "$part" ]] || fail "invalid test PATH"; done
  IFS=$' \t\n'
else
  [[ -x "$PRODUCTION_PYTHON" ]] || fail "required internal Python is unavailable"
fi

script_dir=${BASH_SOURCE[0]%/*}
[[ "$script_dir" != "${BASH_SOURCE[0]}" ]] || script_dir=.
script_dir=$(cd -- "$script_dir" && /bin/pwd -P)

[[ -n "$original" ]] || fail "missing SSH_ORIGINAL_COMMAND"
cmd= env_name= sha= digest=
if [[ "$original" =~ ^(upload|activate)\ (dev|live)\ ([0-9a-f]{40})\ ([0-9a-f]{64})$ ]]; then
  cmd=${BASH_REMATCH[1]}; env_name=${BASH_REMATCH[2]}; sha=${BASH_REMATCH[3]}; digest=${BASH_REMATCH[4]}
elif [[ "$original" =~ ^(status|rollback)\ (dev|live)$ ]]; then
  cmd=${BASH_REMATCH[1]}; env_name=${BASH_REMATCH[2]}
else
  fail "rejected SSH_ORIGINAL_COMMAND"
fi
[[ "$env_name" == "$allowed_env" ]] || fail "command not authorized for environment"

child_env=(/usr/bin/env -i "PATH=$PATH")
if [[ "$test_mode" == true ]]; then
  child_env+=("PREFIX=$prefix" "GPU_MONITOR_TEST_PATH=$PATH"
    "GPU_MONITOR_INTERNAL_PYTHON=$internal_python" "GPU_MONITOR_MAX_UPLOAD_BYTES=$max_upload")
  for pair in \
    "GPU_MONITOR_MAX_ARCHIVE_FILES:${test_max_archive_files:-}" \
    "GPU_MONITOR_MAX_EXPANDED_BYTES:${test_max_expanded_bytes:-}" \
    "GPU_MONITOR_HEALTH_RETRIES:${test_health_retries:-}" \
    "GPU_MONITOR_HEALTH_SLEEP_SECONDS:${test_health_sleep_seconds:-}" \
    "GPU_MONITOR_MAX_INCOMING_COUNT:${test_max_incoming_count:-}" \
    "GPU_MONITOR_MAX_INCOMING_BYTES:${test_max_incoming_bytes:-}" \
    "GPU_MONITOR_UPLOAD_TEMP_MAX_AGE:${test_temp_max_age:-}" \
    "GPU_MONITOR_FAILED_ARTIFACT_MAX_COUNT:${test_failed_max_count:-}"; do
    name=${pair%%:*}; value=${pair#*:}; [[ -z "$value" ]] || child_env+=("$name=$value")
  done
fi

if [[ "$test_mode" == true ]]; then
  exec "${child_env[@]}" "$script_dir/activate-release.sh" --test-mode "$env_name" "$cmd" ${sha:+"$sha"} ${digest:+"$digest"}
fi
exec "${child_env[@]}" "$script_dir/activate-release.sh" "$cmd" "$env_name" ${sha:+"$sha"} ${digest:+"$digest"}
